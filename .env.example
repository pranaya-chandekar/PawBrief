# ===================================================================
# PawBrief Configuration & Environment Variables
# ===================================================================
# Copy this file to .env before starting:
# cp .env.example .env
#
# NOTE: Never commit live production secrets, service keys, or private API keys to git.
# ===================================================================

# Server Port and CORS
PORT=8080
ALLOWED_ORIGIN=*

# -------------------------------------------------------------------
# 1. Google Gemini AI Service
# -------------------------------------------------------------------
# Option A: Google AI Studio API Key (Simplest, Recommended for Hackathon)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Model selection (Recommended: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Option B: Google Cloud Vertex AI (For GCP Service Account authentication)
# If GCP_PROJECT_ID is set and credentials are provided, Vertex AI will be used.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# -------------------------------------------------------------------
# 2. Google Maps Platform & Google Places API
# -------------------------------------------------------------------
# Used for the geospatial dispatch map and real nearby veterinary clinic discovery.
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials
# Enable: Maps JavaScript API, Places API (New), Geocoding API
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# -------------------------------------------------------------------
# 3. Firebase Auth & Cloud Firestore
# -------------------------------------------------------------------
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps (Web)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=pawbrief-demo.firebaseapp.com
FIREBASE_PROJECT_ID=pawbrief-demo
FIREBASE_STORAGE_BUCKET=pawbrief-demo.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional: Path to Firebase Service Account JSON (for production Firestore sync & server token verification)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json
